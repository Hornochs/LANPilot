# LANPilot environment configuration (example).
#
# Every setting from lanpilot.toml can be overridden with an environment variable:
# LANPILOT_<SECTION>__<KEY>. Copy this file to .env and adjust it; never commit .env.
# Empty values are ignored. `lanpilot config show` prints the effective configuration.

# Address under which users reach LANPilot. Required. Determines accepted Host headers,
# the origin check for state-changing requests and whether cookies get the Secure flag.
LANPILOT_SERVER__PUBLIC_URL=https://lanpilot.example.lan

# Where the application itself listens. Keep it on loopback behind a reverse proxy.
LANPILOT_SERVER__BIND=127.0.0.1
LANPILOT_SERVER__PORT=9030

# Additional host names or IPs that are accepted besides the one in PUBLIC_URL (comma separated).
LANPILOT_SERVER__ALLOWED_HOSTS=

# Proxies whose X-Forwarded-For / X-Forwarded-Proto headers are trusted (IPs or CIDR, comma
# separated). Leave empty when no reverse proxy is used.
LANPILOT_SERVER__TRUSTED_PROXIES=127.0.0.1

# Key used to encrypt game server credentials at rest. Required. Generate one with
#   lanpilot secret generate-key
# and keep it secret. Losing this key means all stored server passwords have to be entered
# again. Alternatively set LANPILOT_SECRET_KEY_FILE to a file (mode 600) containing the key.
LANPILOT_SECRET_KEY=

# Directory for the SQLite database and the map image cache.
LANPILOT_DATA_DIR=./data

# debug, info, warning or error.
LANPILOT_LOG_LEVEL=info

# How often every game server is asked for its status, and how long to wait for an answer.
LANPILOT_POLLING__INTERVAL_SECONDS=10
LANPILOT_POLLING__TIMEOUT_SECONDS=8

# A session ends after this many minutes without activity, and in any case this many hours
# after sign-in.
LANPILOT_AUTH__SESSION_IDLE_MINUTES=720
LANPILOT_AUTH__SESSION_LIFETIME_HOURS=168

# Upgrade the database schema automatically when `lanpilot serve` starts. A backup of the
# database is written first. Set to false to run `lanpilot db upgrade` yourself.
LANPILOT_AUTO_MIGRATE=true

# Offer a simulated game server for trying LANPilot out. Not meant for production.
LANPILOT_ENABLE_DEMO_ADAPTER=false

# Let administrators send raw console commands to game servers.
LANPILOT_ENABLE_CONSOLE=false

# Language of the user interface when neither the user nor the browser picks one: en or de.
LANPILOT_DEFAULT_LANGUAGE=en

# Networks for the on-demand LAN scan (comma separated); empty: no scan.
LANPILOT_SCAN__NETWORKS=
LANPILOT_SCAN__TIMEOUT_SECONDS=2

# Look for map images on the internet, and which sources to ask (comma separated).
LANPILOT_IMAGES__ONLINE=true
LANPILOT_IMAGES__SOURCES=steam_workshop,gamebanana,gametracker,tmx,unreal_archive
